# FreshPress Customer App — Environment Variables
#
# Copy this file to .env.local (or .env) and fill in the values
# for your environment. All variables must be prefixed with
# EXPO_PUBLIC_ so that Expo's Metro bundler injects them at build
# time (see: https://docs.expo.dev/guides/environment-variables/).
#
# IMPORTANT: Never commit .env or .env.local to version control.
# ─────────────────────────────────────────────────────────────────

# Base URL for the FreshPress API Gateway (no trailing slash).
# Example: https://api.freshpress.in/v1
EXPO_PUBLIC_API_BASE_URL=https://api.freshpress.in/v1

# WebSocket server URL used by socket.io-client for real-time
# order status and GPS tracking updates.
# Example: wss://ws.freshpress.in
EXPO_PUBLIC_WS_URL=wss://ws.freshpress.in

# Razorpay publishable key ID. Obtain this from the Razorpay
# Dashboard → Settings → API Keys.
# Example: rzp_test_xxxxxxxxxxxx
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
